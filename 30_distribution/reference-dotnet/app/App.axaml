<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Taktera.Reference.App">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Taktera.UI.Avalonia/Assets/TkFieldStyles.axaml"/>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Taktera.UI.Avalonia/Assets/Taktera.Clinic.Light.axaml"/>
        <ResourceInclude Source="avares://Taktera.UI.Avalonia/Assets/TkControls.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
